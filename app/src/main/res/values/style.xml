    <style name="ThemeMint" parent="@android:style/Theme.Holo.Light.DarkActionBar">
        <item name="android:windowBackground">@color/bg_mint</item>
        <item name="android:actionBarStyle">@style/ActionBarMint</item>
        <item name="noteBg">@color/bg_mint</item>
        <item name="noteCard">@drawable/card_mint</item>
        <item name="noteTitle">@color/title_mint</item>
        <item name="noteTime">@color/time_mint</item>
