<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 应用主主题：浅色基础 + 玫红顶栏 -->
    <style name="AppTheme" parent="@android:style/Theme.Holo.Light.DarkActionBar">
        <item name="android:actionBarStyle">@style/PinkActionBar</item>
    </style>

    <!-- 顶栏样式：玫红背景 + 白色标题 -->
    <style name="PinkActionBar" parent="@android:style/Widget.Holo.Light.ActionBar">
        <item name="android:background">@color/accent</item>
        <item name="android:titleTextStyle">@style/PinkActionBarTitle</item>
    </style>

    <style name="PinkActionBarTitle"
        parent="@android:style/TextAppearance.Holo.Widget.ActionBar.Title">
        <item name="android:textColor">#FFFFFF</item>
    </style>

</resources>
