        <item name="android:background">@color/accent</item>
        <item name="android:titleTextStyle">@style/ActionBarTitleWhite</item>
    </style>

    <style name="ActionBarMint" parent="@android:style/Widget.Holo.Light.ActionBar">
        <item name="android:background">@color/accent_mint</item>
