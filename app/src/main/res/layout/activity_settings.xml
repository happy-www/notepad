<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/noteBg"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_theme"
        android:textColor="?attr/noteTitle"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/theme_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <RadioButton
            android:id="@+id/theme_pink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_pink"
            android:textColor="?attr/noteTitle" />

        <RadioButton
            android:id="@+id/theme_mint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_mint"
            android:textColor="?attr/noteTitle" />

        <RadioButton
            android:id="@+id/theme_paper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_paper"
            android:textColor="?attr/noteTitle" />

        <RadioButton
            android:id="@+id/theme_night"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_night"
            android:textColor="?attr/noteTitle" />
    </RadioGroup>

    <TextView
        android:id="@+id/size_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/settings_text_size"
        android:textColor="?attr/noteTitle"
        android:textSize="18sp"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/size_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_apply" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/settings_reset" />
    </LinearLayout>
</LinearLayout>
