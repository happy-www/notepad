<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 樱花粉（默认主题） -->
    <style name="AppTheme" parent="@android:style/Theme.Holo.Light.DarkActionBar">
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:actionBarStyle">@style/ActionBarPink</item>
        <item name="noteBg">@color/bg_page</item>
        <item name="noteCard">@drawable/card_white</item>
        <item name="noteTitle">@color/title_color</item>
        <item name="noteTime">@color/time_color</item>
        <item name="noteAccent">@color/accent</item>
        <item name="noteEditorLine">@color/line_pink</item>
        <item name="noteHint">@color/hint_pink</item>
        <item name="noteDivider">@color/divider_pink</item>
    </style>

